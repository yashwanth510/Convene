# Backend secrets: never expose these through VITE variables.
GROQ_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=

# QwenCloud uses the international endpoint below.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Local SQLite; use the Neon PostgreSQL connection string when hosting.
DATABASE_URL=sqlite+aiosqlite:///data/convene.db
APP_ENV=development
DEBUG=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Production requires a private random invitation code of at least 16 characters.
INVITE_CODE=
SESSION_DAYS=7
DAILY_RUN_LIMIT=15
MAX_ACTIVE_RUNS=2
MAX_CONCURRENT_REQUESTS=3
DEBATE_PANEL_SIZE=4
RUN_TOKEN_BUDGET=48000
RUN_CALL_BUDGET=18
SEARCH_BUDGET=1
REQUEST_TIMEOUT=120
COMPLEX_REQUEST_TIMEOUT=300

# Admin account IDs: one ID, comma-separated IDs, or a JSON array. Empty disables access.
ADMIN_USER_IDS=[]
