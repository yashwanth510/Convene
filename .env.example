# Backend only. Never place these secrets in frontend/VITE variables.
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional providers/search:
MISTRAL_API_KEY=
TAVILY_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=

# Local development uses SQLite; replace with the Neon connection string for hosting.
DATABASE_URL=sqlite+aiosqlite:///data/convene.db
APP_ENV=development
DEBUG=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Required in production: random value at least 16 characters, shared with invitees.
INVITE_CODE=
SESSION_DAYS=7
DAILY_RUN_LIMIT=15
MAX_ACTIVE_RUNS=2
DEBATE_PANEL_SIZE=4
RUN_TOKEN_BUDGET=48000
RUN_CALL_BUDGET=18
SEARCH_BUDGET=2
REQUEST_TIMEOUT=120
COMPLEX_REQUEST_TIMEOUT=300
