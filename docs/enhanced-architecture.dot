digraph Convene {
  graph [rankdir=TB, bgcolor="#fafaf7", pad=.5, nodesep=.35, ranksep=.5, fontname="DejaVu Sans", label="Convene · end-to-end architecture", labelloc=t, fontsize=24];
  node [shape=box, style="rounded,filled", fillcolor="#f1f2ec", color="#b6bfae", fontname="DejaVu Sans", fontsize=12, margin=".2,.14"];
  edge [color="#788570", fontname="DejaVu Sans", fontsize=10];
  ui [label="React workspace\nCloudflare Pages"];
  api [label="FastAPI · Render\nAuthentication · ownership · quotas"];
  run [label="Idempotent run + bounded queue\nContext memory + documents"];
  router [label="Rule-based router\nFast answer or council"];
  source [label="Optional Tavily retrieval\nBounded source excerpts"];
  draft [label="Independent model drafts\nThinker · worker · critic · researcher"];
  review [label="Anonymized review\nAgreement · bounded revisions"];
  synth [label="Streamed synthesis"];
  verify [label="Evidence assessment\nExact excerpts · unknown stays unknown"];
  gateway [label="Provider gateway\nBudgets · concurrency · cooldowns"];
  models [label="Groq · OpenRouter\nNemotron 3 Super + 3.5 Lightning\nOptional Mistral"];
  db [label="Neon PostgreSQL\nAccounts · chats · runs · usage\nOrdered events · saved answers", shape=cylinder, fillcolor="#e4eadc"];
  events [label="Authenticated event replay\nReconnect · feedback · export"];
  ui -> api -> run -> router -> source;
  source -> draft -> review -> synth -> verify;
  source -> synth [label="fast"];
  {draft review synth verify} -> gateway [style=dashed];
  gateway -> models;
  api -> db;
  run -> db [label="reserve"];
  verify -> db [label="atomic finish"];
  db -> events -> ui;
}
